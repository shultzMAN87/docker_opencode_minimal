# Скопируйте в .env и заполните нужное. .env в git не попадает.
# Все переменные из этого файла видны внутри контейнера, поэтому
# в mcp.json на них можно ссылаться как {env:ИМЯ}.

# --- Образ и запуск ---
OPENCODE_VERSION=1.19.3
OPENCODE_PORT=4096
# Папка с проектом на хосте, которая станет /workspace в контейнере
WORKSPACE_DIR=./workspace
# Пароль на веб-интерфейс (логин: opencode). Закомментировано — без пароля.
# OPENCODE_SERVER_PASSWORD=change-me

# --- Ключи LLM-провайдеров ---
# Раскомментируйте нужный, либо подключите провайдера командой /connect в интерфейсе.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# --- Секреты для MCP-серверов ---
# EXAMPLE_MCP_TOKEN=
